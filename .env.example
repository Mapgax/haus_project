# Required for local migration and GitHub Actions.
# Use the Supabase pooler or direct Postgres connection string with sslmode=require.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require

# Optional alias for tools that expect DATABASE_URL.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require

# ntfy.sh topic for push notifications about new listings. Topics on ntfy.sh
# are readable by anyone who guesses the name — use a random suffix
# (e.g. hausfinder-x7k2q9) and keep it out of the repo. Also stored as the
# NTFY_TOPIC GitHub Actions secret. Leave empty to disable notifications.
NTFY_TOPIC=
